      "blocks": {
        "choose": {
          "type": "answer",
          "settings": {
            "question": "Where should I start?",
            "answer": "<p>For days in work boots, start with our <a href=\"/collections/australian-made-work-socks\">work sock range</a>. For everyday wear, explore the <a href=\"/products/elite_cotton_socks\">Elite cotton sock</a>. Each product page includes its materials and available sizes.</p>"
          }
        },
        "size": {
          "type": "answer",
          "settings": {
            "question": "How do I choose my size?",
            "answer": "<p>Check the size information on the product page before choosing your size. If you are between sizes or unsure, <a href=\"/pages/contact\">contact us</a> and we will help you find a fit.</p>"
          }
        },
        "guarantee": {
          "type": "answer",
          "settings": {
            "question": "Which socks have a lifetime guarantee?",
            "answer": "<p>The True-Blue Lifetime Guarantee applies to our Merino range. Read the <a href=\"/pages/true-blue-unconditional-lifetime-guarantee\">guarantee details</a> for the full terms and how to make a claim.</p>"
          }
        },
        "shipping": {
          "type": "answer",
          "settings": {
            "question": "Where can I find delivery and returns information?",
            "answer": "<p>See our <a href=\"/policies/shipping-policy\">shipping policy</a> for delivery information and our <a href=\"/policies/refund-policy\">returns policy</a> for returns.</p>"
          }
        }
      },
