<section class="os-story color-{{ section.settings.color_scheme }} gradient" aria-labelledby="Story-{{ section.id }}">
<div class="os-story__media">{% if section.settings.image != blank %}{% assign photo_alt = section.settings.image.alt | default: section.settings.heading %}{{ section.settings.image | image_url: width: 1400 | image_tag: widths: '480,750,1000,1400', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', class: 'os-cover', alt: photo_alt }}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'os-cover placeholder-svg' }}{% endif %}</div>
<div class="os-story__copy"><p class="os-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="Story-{{ section.id }}">{{ section.settings.heading | escape }}</h2><div class="rte os-intro">{{ section.settings.text }}</div>
{% if section.settings.link != blank %}<a class="button" href="{{ section.settings.link }}">{{ section.settings.label | escape }}</a>{% endif %}
{% if section.settings.secondary_link != blank %}<a class="os-text-link" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}</div></section>
{% schema %}
{
  "name": "Only Socks — brand story",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colours",
      "default": "inverse"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photograph"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "GOOD SOCKS. MADE HERE."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A little more pride in every pair."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We believe Australian made should be an everyday choice. Practical socks, considered materials and a genuine connection to where they are made.</p>"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Button label",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Second link label",
      "default": "Australian Made certification"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Second link"
    }
  ],
  "presets": [
    {
      "name": "Only Socks — brand story"
    }
  ]
}
{% endschema %}
