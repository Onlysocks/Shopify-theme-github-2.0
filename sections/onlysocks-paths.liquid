<section class="os-section color-{{ section.settings.color_scheme }} gradient" aria-labelledby="Paths-{{ section.id }}">
 <div class="page-width"><div class="os-section-heading"><div><p class="os-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="Paths-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div><div class="rte os-heading-note">{{ section.settings.text }}</div></div>
 <div class="os-paths">{% for block in section.blocks %}<article class="os-path" {{ block.shopify_attributes }}>
 {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" class="os-path__link">{% endif %}
 <div class="os-path__media">{% if block.settings.image != blank %}{% assign photo_alt = block.settings.image.alt | default: block.settings.title %}{{ block.settings.image | image_url: width: 1000 | image_tag: widths: '360,540,750,1000', sizes: '(min-width: 750px) 32vw, 100vw', loading: 'lazy', class: 'os-cover', alt: photo_alt }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'os-cover placeholder-svg' }}{% endif %}</div>
 <div class="os-path__title"><h3>{{ block.settings.title | escape }}</h3><span aria-hidden="true">↗</span></div><p>{{ block.settings.text | escape }}</p>
 {% if block.settings.link != blank %}</a>{% endif %}</article>{% endfor %}</div></div>
</section>
{% schema %}
{
  "name": "Only Socks — shop by use",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colours",
      "default": "inverse"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "FIND YOUR EVERYDAY PAIR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Whatever your day holds."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction",
      "default": "<p>Start with where you wear them.</p>"
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "category",
      "name": "Shopping category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photograph"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Work socks"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "For days in your boots."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Destination"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Only Socks — shop by use"
    }
  ]
}
{% endschema %}
